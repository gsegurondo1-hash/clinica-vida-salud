# Copie este archivo como .env para ejecutar en local
APP_SECRET=cambie-esta-clave-por-una-larga-y-aleatoria-123456
APP_TIMEZONE=America/La_Paz
APP_DEBUG=true

# Base de datos local (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinica_vida_salud
DB_USER=postgres
DB_PASSWORD=postgres
# En la nube Render entrega DATABASE_URL y reemplaza lo anterior:
# DATABASE_URL=postgresql://usuario:clave@host:5432/base

# URL del frontend (CORS y enlaces de recuperacion de contrasena)
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:8080

# Contrasena de los usuarios de prueba
DEMO_PASSWORD=Clinica2026*
# Muestra en pantalla el enlace de recuperacion cuando no hay proveedor de correo
DEMO_MODE=true

# Opcional: correos reales con Resend (https://resend.com)
# RESEND_API_KEY=
# MAIL_FROM=Clinica Vida Salud <notificaciones@su-dominio.com>

# Clave para la tarea de recordatorios por URL
CRON_SECRET=cambie-esta-clave-del-cron
